# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored - never commit real secrets.

# Get a key from https://console.anthropic.com (API Keys section).
ANTHROPIC_API_KEY=

# "mock" (default) uses the free, deterministic MockAIProvider.
# "anthropic" uses the real Claude API and requires ANTHROPIC_API_KEY above.
AI_PROVIDER=mock
